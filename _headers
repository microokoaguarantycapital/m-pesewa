# Additional headers for specific routes
/app-shell
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
  
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable
  
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *