/**
 * M-PESEWA MENU RENDERER (CONTINUED)
 * Renders menu structures based on strict hierarchy and user roles
 * Version: 1.0.0
 * Last Updated: 2024-01-24
 */

class MpesewaMenuRenderer {
    constructor(contextResolver) {
        this.contextResolver = contextResolver || window.MpesewaContextResolver;
        this.menuTemplates = this._initializeMenuTemplates();
        this.currentMenus = {};
        this.init();
    }

    init() {
        this._loadMenuState();
        this._renderAllMenus();
        this._setupMenuEventListeners();
    }

    _initializeMenuTemplates() {
        return {
            // STRICT HIERARCHY MENUS
            hierarchy: {
                // Global menu (for platform admin)
                global: this._getGlobalMenu(),
                
                // Country-specific menus (12 countries)
                country: {
                    KE: this._getKenyaMenu(),
                    UG: this._getUgandaMenu(),
                    TZ: this._getTanzaniaMenu(),
                    RW: this._getRwandaMenu(),
                    BI: this._getBurundiMenu(),
                    CD: this._getDRCMenu(),
                    NG: this._getNigeriaMenu(),
                    GH: this._getGhanaMenu(),
                    SS: this._getSouthSudanMenu(),
                    SO: this._getSomaliaMenu(),
                    ZA: this._getSouthAfricaMenu(),
                    ET: this._getEthiopiaMenu()
                },
                
                // Group menus (unlimited per country)
                group: {
                    admin: this._getGroupAdminMenu(),
                    member: this._getGroupMemberMenu(),
                    lender: this._getGroupLenderMenu(),
                    borrower: this._getGroupBorrowerMenu()
                },
                
                // Lender menus (with subscription tiers)
                lender: {
                    basic: this._getLenderBasicMenu(),
                    premium: this._getLenderPremiumMenu(),
                    super: this._getLenderSuperMenu(),
                    lender_of_lenders: this._getLenderOfLendersMenu()
                },
                
                // Borrower menus (with rating tiers)
                borrower: {
                    rating_1_2: this._getBorrowerLowRatingMenu(),
                    rating_3_4: this._getBorrowerMediumRatingMenu(),
                    rating_5: this._getBorrowerHighRatingMenu(),
                    blacklisted: this._getBorrowerBlacklistedMenu()
                }
            },
            
            // ROLE-BASED MENUS
            roles: {
                guest: this._getGuestMenu(),
                borrower: this._getBorrowerRoleMenu(),
                lender: this._getLenderRoleMenu(),
                group_admin: this._getGroupAdminRoleMenu(),
                platform_admin: this._getPlatformAdminMenu()
            },
            
            // CONTEXTUAL MENUS
            contextual: {
                emergency: this._getEmergencyContextMenu(),
                subscription: this._getSubscriptionContextMenu(),
                ledger: this._getLedgerContextMenu(),
                blacklist: this._getBlacklistContextMenu(),
                debt_collectors: this._getDebtCollectorsMenu()
            },
            
            // MENU STYLING
            styling: {
                colors: {
                    primary: '#003366',
                    secondary: '#0099ff',
                    success: '#28a745',
                    warning: '#ffc107',
                    danger: '#dc3545',
                    light: '#f8f9fa',
                    dark: '#343a40'
                },
                icons: {
                    // Hierarchy icons
                    global: '🌍',
                    country: '🇰🇪',
                    group: '👥',
                    lender: '💰',
                    borrower: '💼',
                    ledger: '📒',
                    
                    // Action icons
                    create: '➕',
                    edit: '✏️',
                    delete: '🗑️',
                    view: '👁️',
                    settings: '⚙️',
                    help: '❓',
                    
                    // Status icons
                    active: '🟢',
                    inactive: '⚫',
                    pending: '🟡',
                    completed: '✅',
                    overdue: '🔴',
                    blacklisted: '🚫'
                }
            }
        };
    }

