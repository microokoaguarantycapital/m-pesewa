        this.currentMenus[menuType] = menuData;
        this._saveMenuState();
        
        // Re-render if container exists
        const containerId = `${menuType}-menu-container`;
        const container = document.getElementById(containerId);
        if (container && menuData) {
            this._renderMenuToDOM(containerId, menuData);
        }
    }

    clearMenu(menuType) {
        delete this.currentMenus[menuType];
        this._saveMenuState();
        
        const containerId = `${menuType}-menu-container`;
        const container = document.getElementById(containerId);
        if (container) {
            container.innerHTML = '';
        }
    }

