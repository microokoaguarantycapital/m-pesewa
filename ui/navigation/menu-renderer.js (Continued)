    // MENU RENDERING METHODS
    _loadMenuState() {
        try {
            const savedMenus = localStorage.getItem('mpesewa_menus');
            if (savedMenus) {
                this.currentMenus = JSON.parse(savedMenus);
            }
        } catch (error) {
            console.error('Error loading menu state:', error);
            this.currentMenus = {};
        }
    }

    _saveMenuState() {
        localStorage.setItem('mpesewa_menus', JSON.stringify(this.currentMenus));
    }

    _renderAllMenus() {
        const context = this.contextResolver?.getCurrentContext() || {};
        
        // Render based on hierarchy level
        this._renderHierarchyMenu(context);
        
        // Render based on user role
        this._renderRoleMenu(context);
        
        // Render contextual menus
        this._renderContextualMenus(context);
    }

    _renderHierarchyMenu(context) {
        const hierarchy = context.level;
        const country = context.country;
        const group = context.group;
        const role = context.role;
        
        let menuTemplate = null;
        
        switch(hierarchy) {
            case 'global':
                menuTemplate = this.menuTemplates.hierarchy.global;
                break;
                
            case 'country':
                if (country && this.menuTemplates.hierarchy.country[country]) {
                    menuTemplate = this.menuTemplates.hierarchy.country[country];
                }
                break;
                
            case 'group':
                if (group) {
                    const groupRole = context.groupRole || 'member';
                    menuTemplate = this.menuTemplates.hierarchy.group[groupRole];
                }
                break;
                
            case 'lender':
                if (context.subscription?.tier) {
                    const tier = context.subscription.tier;
                    menuTemplate = this.menuTemplates.hierarchy.lender[tier];
                }
                break;
                
            case 'borrower':
                const rating = context.rating || 0;
                let ratingLevel = 'rating_1_2';
                
                if (rating >= 5) ratingLevel = 'rating_5';
                else if (rating >= 3) ratingLevel = 'rating_3_4';
                
                if (context.blacklisted) {
                    ratingLevel = 'blacklisted';
                }
                
                menuTemplate = this.menuTemplates.hierarchy.borrower[ratingLevel];
                break;
        }
        
        if (menuTemplate) {
            this.currentMenus.hierarchy = menuTemplate;
            this._renderMenuToDOM('hierarchy-menu-container', menuTemplate);
        }
    }

    _renderRoleMenu(context) {
        const role = context.role || 'guest';
        
        if (this.menuTemplates.roles[role]) {
            const roleMenu = this.menuTemplates.roles[role];
            this.currentMenus.role = roleMenu;
            this._renderMenuToDOM('role-menu-container', roleMenu);
        }
    }

    _renderContextualMenus(context) {
        const path = window.location.pathname;
        
        // Check for emergency hub
        if (path.includes('/emergency/')) {
            this._renderMenuToDOM('contextual-menu-container', this.menuTemplates.contextual.emergency);
            this.currentMenus.contextual = 'emergency';
        }
        
        // Check for subscription pages
        else if (path.includes('/subscription/')) {
            this._renderMenuToDOM('contextual-menu-container', this.menuTemplates.contextual.subscription);
            this.currentMenus.contextual = 'subscription';
        }
        
        // Check for ledger pages
        else if (path.includes('/ledgers/')) {
            this._renderMenuToDOM('contextual-menu-container', this.menuTemplates.contextual.ledger);
            this.currentMenus.contextual = 'ledger';
        }
        
        // Check for blacklist pages
        else if (path.includes('/blacklist/')) {
            this._renderMenuToDOM('contextual-menu-container', this.menuTemplates.contextual.blacklist);
            this.currentMenus.contextual = 'blacklist';
        }
        
        // Check for debt collectors
        else if (path.includes('/collectors/')) {
            this._renderMenuToDOM('contextual-menu-container', this.menuTemplates.contextual.debt_collectors);
            this.currentMenus.contextual = 'debt_collectors';
        }
    }

    _renderMenuToDOM(containerId, menuTemplate) {
        const container = document.getElementById(containerId);
        if (!container || !menuTemplate) return;
        
        const html = this._generateMenuHTML(menuTemplate);
        container.innerHTML = html;
        
        // Attach event listeners
        this._attachMenuEventListeners(container, menuTemplate);
    }

    _generateMenuHTML(menu) {
        const { colors, icons } = this.menuTemplates.styling;
        
        return `
            <div class="mp-menu" data-menu-id="${menu.id}">
                <div class="menu-header">
                    <h3 class="menu-title">${menu.title}</h3>
                    ${menu.subtitle ? `<p class="menu-subtitle">${menu.subtitle}</p>` : ''}
                </div>
                
                <nav class="menu-nav" aria-label="${menu.title}">
                    <ul class="menu-list">
                        ${menu.items.map(item => this._generateMenuItemHTML(item)).join('')}
                    </ul>
                </nav>
                
                ${menu.footer ? `
                    <div class="menu-footer">
                        ${menu.footer}
                    </div>
                ` : ''}
            </div>
        `;
    }

    _generateMenuItemHTML(item) {
        const hasSubItems = item.subItems && item.subItems.length > 0;
        const isDisabled = item.disabled || (item.roles && !this._canAccessMenuItem(item));
        
        let itemHTML = '';
        
        if (hasSubItems) {
            itemHTML = `
                <li class="menu-item ${isDisabled ? 'disabled' : ''}" data-item-id="${item.id}">
                    <button class="menu-link accordion-toggle" ${isDisabled ? 'disabled' : ''}>
                        <span class="menu-icon">${item.icon}</span>
                        <span class="menu-label">${item.label}</span>
                        ${item.badge ? `<span class="menu-badge">${item.badge}</span>` : ''}
                        <span class="menu-arrow">▸</span>
                    </button>
                    <div class="menu-subitems">
                        ${item.subItems.map(subItem => this._generateSubMenuItemHTML(subItem)).join('')}
                    </div>
                </li>
            `;
        } else {
            if (item.action) {
                itemHTML = `
                    <li class="menu-item ${isDisabled ? 'disabled' : ''}" data-item-id="${item.id}">
                        <button class="menu-link" 
                                data-action="${item.action}"
                                ${item.role ? `data-role="${item.role}"` : ''}
                                ${isDisabled ? 'disabled' : ''}>
                            <span class="menu-icon">${item.icon}</span>
                            <span class="menu-label">${item.label}</span>
                            ${item.badge ? `<span class="menu-badge">${item.badge}</span>` : ''}
                        </button>
                    </li>
                `;
            } else {
                itemHTML = `
                    <li class="menu-item ${isDisabled ? 'disabled' : ''}" data-item-id="${item.id}">
                        <a href="${item.path}" class="menu-link" ${isDisabled ? 'aria-disabled="true"' : ''}>
                            <span class="menu-icon">${item.icon}</span>
                            <span class="menu-label">${item.label}</span>
                            ${item.badge ? `<span class="menu-badge">${item.badge}</span>` : ''}
                        </a>
                    </li>
                `;
            }
        }
        
        return itemHTML;
    }

    _generateSubMenuItemHTML(subItem) {
        const isDisabled = subItem.disabled || (subItem.roles && !this._canAccessMenuItem(subItem));
        
        if (subItem.action) {
            return `
                <div class="menu-subitem ${isDisabled ? 'disabled' : ''}" data-item-id="${subItem.id}">
                    <button class="menu-sublink" 
                            data-action="${subItem.action}"
                            ${isDisabled ? 'disabled' : ''}>
                        <span class="menu-icon">${subItem.icon}</span>
                        <span class="menu-label">${subItem.label}</span>
                    </button>
                </div>
            `;
        } else {
            return `
                <div class="menu-subitem ${isDisabled ? 'disabled' : ''}" data-item-id="${subItem.id}">
                    <a href="${subItem.path}" class="menu-sublink" ${isDisabled ? 'aria-disabled="true"' : ''}>
                        <span class="menu-icon">${subItem.icon}</span>
                        <span class="menu-label">${subItem.label}</span>
                    </a>
                </div>
            `;
        }
    }

    _canAccessMenuItem(item) {
        const user = this.userState || { role: 'guest', isAuthenticated: false };
        
        if (!item.roles) return true;
        
        if (item.roles.includes('all')) return true;
        
        if (!user.isAuthenticated && item.roles.includes('guest')) return true;
        
        if (user.isAuthenticated) {
            if (item.roles.includes('authenticated')) return true;
            if (item.roles.includes(user.role)) return true;
        }
        
        return false;
    }

    _attachMenuEventListeners(container, menu) {
        // Accordion toggles
        container.querySelectorAll('.accordion-toggle').forEach(toggle => {
            toggle.addEventListener('click', (e) => {
                const item = toggle.closest('.menu-item');
                if (item) {
                    this._toggleMenuAccordion(item);
                }
            });
        });
        
        // Action buttons
        container.querySelectorAll('.menu-link[data-action]').forEach(link => {
            link.addEventListener('click', (e) => {
                const action = link.getAttribute('data-action');
                const role = link.getAttribute('data-role');
                this._handleMenuAction(action, role);
            });
        });
        
        // Submenu action buttons
        container.querySelectorAll('.menu-sublink[data-action]').forEach(link => {
            link.addEventListener('click', (e) => {
                const action = link.getAttribute('data-action');
                this._handleMenuAction(action);
            });
        });
    }

    _setupMenuEventListeners() {
        // Global menu event listeners
        document.addEventListener('click', (e) => {
            // Close all accordions when clicking outside
            if (!e.target.closest('.menu-item')) {
                document.querySelectorAll('.menu-item.active').forEach(item => {
                    item.classList.remove('active');
                });
            }
        });
    }

    _toggleMenuAccordion(item) {
        const isActive = item.classList.contains('active');
        
        // Close other accordions in the same menu
        const menu = item.closest('.mp-menu');
        if (menu) {
            menu.querySelectorAll('.menu-item.active').forEach(other => {
                if (other !== item) {
                    other.classList.remove('active');
                }
            });
        }
        
        // Toggle this accordion
        if (isActive) {
            item.classList.remove('active');
        } else {
            item.classList.add('active');
        }
    }

    _handleMenuAction(action, role) {
        switch(action) {
            case 'switchRole':
                if (role && this.contextResolver?.switchRole) {
                    this.contextResolver.switchRole(role);
                }
                break;
                
